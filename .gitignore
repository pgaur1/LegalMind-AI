local_config.py
local_settings.py

# ============================================================================
# DO NOT IGNORE - Essential Data Files
# ============================================================================
# These files should be tracked by Git (remove from ignore)
!vector_store/faiss_index.bin
!vector_store/metadata.json
!vector_store/chunks/chunk_metadata.json
!knowledge_graph/*.json

# ============================================================================
# Large Files (Use Git LFS if needed)
# ============================================================================
# If vector store becomes too large, use Git LFS:
# git lfs track "vector_store/faiss_index.bin"
